{
  "workflowProfiles": {
    "default": {
      "codex": "codex-medium",
      "claude": "claude-medium"
    },
    "files": ".pair/adoption/tech/workflow-profiles/*.json"
  },
  "agents": {
    "targets": ["claude", "codex"]
  },
  "workflows": {
    "default": {
      "configuration": {
        "claude": "claude-medium",
        "codex": "codex-medium"
      },
      "tiers": {
        "risk:red": {
          "claude": "claude-high",
          "codex": "codex-high"
        },
        "risk:yellow": {
          "claude": "claude-medium",
          "codex": "codex-medium"
        },
        "risk:green": {
          "claude": "claude-cheap",
          "codex": "codex-cheap"
        }
      }
    },
    "full": {
      "configuration": {
        "claude": "claude-full",
        "codex": "codex-full"
      }
    }
  }
}
