{
  "$schema": "https://turborepo.org/schema.json",
  "//": "globalDependencies: the formatter tasks are cacheable, and since #394 their ignore SOURCES include the repo-root .gitignore plus the shared ignore files and the bin wrappers that pass them. Without this, adding a generated dir to .gitignore touches no package file, so turbo replays a pre-change result — a stale PASS, or a stale FAIL a developer cannot clear.",
  "globalDependencies": [
    ".gitignore",
    "tools/prettier-config/.prettierignore",
    "tools/prettier-config/bin/**",
    "tools/markdownlint-config/.markdownlintignore",
    "tools/markdownlint-config/bin/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@pair/website#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "ts:check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "prettier:check": {
      "outputs": []
    },
    "prettier:fix": {
      "outputs": []
    },
    "mdlint:check": {
      "outputs": []
    },
    "mdlint:fix": {
      "outputs": []
    },
    "clean": {
      "cache": false,
      "outputs": []
    },
    "ct": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "a11y:report": {
      "cache": false
    },
    "a11y:report:html": {
      "cache": false
    },
    "quality-gate": {
      "dependsOn": ["^ts:check", "^test", "^lint"],
      "outputs": []
    }
  }
}
