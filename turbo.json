{
  "$schema": "https://turborepo.org/schema.json",
  "//": "globalDependencies: the formatter tasks are cacheable, and since #394 their ignore SOURCES include the repo-root .gitignore plus the shared ignore files and the bin wrappers that pass them. Without this, adding a generated dir to .gitignore touches no package file, so turbo replays a pre-change result — a stale PASS, or a stale FAIL a developer cannot clear. BLAST RADIUS ACCEPTED DELIBERATELY: globalDependencies is the widest invalidation lever there is — turbo folds it into the GLOBAL hash, so editing .gitignore, either shared ignore file, or anything under the two bin/** dirs also busts build/test/ts:check/lint/test:coverage caches that cannot possibly be affected, i.e. a full local + CI rebuild and retest on an edit that changes no compilation input. The narrower option (per-task inputs on prettier:check|prettier:fix|mdlint:check|mdlint:fix = [\"$TURBO_DEFAULT$\", \"../../.gitignore\", \"../../tools/prettier-config/**\", ...]) was passed over on purpose: it hardcodes the ../../ depth in four places (wrong for a differently nested package) and degrades SILENTLY to a stale cache when a fifth formatter task is added without it, whereas over-approximation only ever fails towards extra work. Revisit if the over-invalidation becomes measurable.",
  "globalDependencies": [
    ".gitignore",
    "tools/prettier-config/.prettierignore",
    "tools/prettier-config/bin/**",
    "tools/markdownlint-config/.markdownlintignore",
    "tools/markdownlint-config/bin/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@pair/website#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    // @pair/knowledge-hub's conformance suite asserts on REPO-WIDE artifacts that live OUTSIDE its
    // own package: the KB under .pair/, the installed skills under .claude/, the docs content, and
    // the release-validation paths under qa/. The default cache key ($TURBO_DEFAULT$ = the
    // package's own files + globalDependencies) sees none of them, so the guards replayed a stale
    // PASS. MEASURED before this entry: adding apps/website/content/docs/reference/zz-cache-probe.mdx
    // and running `turbo run test --filter @pair/knowledge-hub` printed `3 successful, 3 cached
    // >>> FULL TURBO`, while the same suite run through vitest directly printed `1 failed | 1
    // passed` on the CP5-vs-filesystem assertion. CI was never affected (no remote cache, no .turbo
    // restore in ci.yml — every CI run is cold), so this closed a LOCAL false green, not a
    // merge-gate hole. $TURBO_ROOT$ (turbo >= 2.1) is what makes these paths expressible without
    // hardcoding a ../../ depth — the objection that ruled the same treatment out for the formatter
    // tasks in the note above.
    "@pair/knowledge-hub#test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.claude/**",
        "$TURBO_ROOT$/.claude-plugin/marketplace.json",
        "$TURBO_ROOT$/.pair/**",
        "$TURBO_ROOT$/apps/pair-cli/config.json",
        "$TURBO_ROOT$/apps/website/content/docs/**",
        "$TURBO_ROOT$/apps/website/e2e/docs.e2e.test.ts",
        "$TURBO_ROOT$/qa/**"
      ]
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "@pair/knowledge-hub#test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.claude/**",
        "$TURBO_ROOT$/.claude-plugin/marketplace.json",
        "$TURBO_ROOT$/.pair/**",
        "$TURBO_ROOT$/apps/pair-cli/config.json",
        "$TURBO_ROOT$/apps/website/content/docs/**",
        "$TURBO_ROOT$/apps/website/e2e/docs.e2e.test.ts",
        "$TURBO_ROOT$/qa/**"
      ]
    },
    "ts:check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "prettier:check": {
      "outputs": []
    },
    "prettier:fix": {
      "outputs": []
    },
    "mdlint:check": {
      "outputs": []
    },
    "mdlint:fix": {
      "outputs": []
    },
    "clean": {
      "cache": false,
      "outputs": []
    },
    "ct": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "a11y:report": {
      "cache": false
    },
    "a11y:report:html": {
      "cache": false
    },
    "quality-gate": {
      "dependsOn": ["^ts:check", "^test", "^lint"],
      "outputs": []
    }
  }
}
