{
  "name": "@pair/workflows",
  "version": "0.5.2",
  "description": "Workflows described in YAML: grammar, validator, step kinds, the next/record engine and the dispatch message. Launches nothing itself; a host does.",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "require": "./dist/cli/index.js"
    },
    "./worktree": {
      "types": "./dist/worktree/index.d.ts",
      "import": "./dist/worktree/index.js",
      "require": "./dist/worktree/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "bundle:workflow": "node scripts/bundle-workflow.mjs",
    "prettier:fix": "prettier-fix",
    "prettier:check": "prettier-check",
    "test": "vitest run",
    "test:push": "vitest run --changed \"$PAIR_PUSH_BASE\" --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "ts:check": "tsc --noEmit",
    "lint": "lint",
    "lint:fix": "lint-fix",
    "mdlint:check": "markdownlint-check",
    "mdlint:fix": "markdownlint-fix",
    "kinds:reference": "ts-node -T src/kinds/reference-cli.ts > ../knowledge-hub/dataset/.pair/knowledge/guidelines/collaboration/automation/workflow-kinds.md",
    "schema:reference": "ts-node -T src/describe/reference-cli.ts > ../knowledge-hub/dataset/.pair/knowledge/guidelines/collaboration/automation/workflow-schema.md"
  },
  "dependencies": {
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@pair/eslint-config": "workspace:*",
    "@pair/markdownlint-config": "workspace:*",
    "@pair/prettier-config": "workspace:*",
    "@pair/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "@vercel/ncc": "0.45.0",
    "@vitest/coverage-v8": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "prettier": "@pair/prettier-config"
}
