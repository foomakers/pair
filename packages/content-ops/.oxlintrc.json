{
  "extends": ["../../tools/oxlint-config/base.json"],
  "ignorePatterns": [
    "/dist/",
    "/build/",
    "node_modules/",
    "/*.config.js",
    "/*.config.ts",
    "/playwright/",
    "/test-results/",
    "/dataset/.workflows/",
    "/dataset/.skills/**/scripts/**/*.mjs",
    "*.mts",
    "!*.mts/",
    "*.cts",
    "!*.cts/",
    "*.jsx",
    "!*.jsx/"
  ],
  "overrides": [
    {
      "files": ["src/http/retry.domain.ts"],
      "rules": {
        "pair-domain/no-optional-domain-properties": "error",
        "pair-domain/no-explicit-nullish-domain-types": "error",
        "pair-domain/no-unsafe-domain-assertions": "error"
      }
    },
    {
      "files": ["test/fixtures/domain-compile-negative/**/*.{ts,tsx}"],
      "rules": {
        "legacy-typescript/ban-ts-comment": [
          "error",
          { "ts-expect-error": { "descriptionFormat": "^:\\s*\\S" }, "minimumDescriptionLength": 0 }
        ]
      }
    }
  ]
}
