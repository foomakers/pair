{
  "extends": ["../../tools/oxlint-config/react.json"],
  "ignorePatterns": [
    "/dist/",
    "/build/",
    "node_modules/",
    "/*.config.js",
    "/*.config.ts",
    "/playwright/",
    "/test-results/",
    "/dataset/.workflows/",
    "/dataset/.skills/**/scripts/**/*.mjs",
