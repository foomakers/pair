#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# A linked worktree's hooks inherit GIT_DIR/GIT_INDEX_FILE: any fixture below that spawns `git init` in a
# temp dir would re-initialise THIS repository (core.bare=true). Scrubbed once, for everything the hook runs.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_NAMESPACE GIT_CEILING_DIRECTORIES GIT_IMPLICIT_WORK_TREE GIT_DISCOVERY_ACROSS_FILESYSTEM

pnpm ts:check

# docs:staleness is cheap (measured ~3.4s wall, ts:check ~5.6s) and was push-gate-only, so a stale
# doc string (planned marker on a closed issue, skill/command counts, dead /docs links) failed late,
# at push. Run it here too. Offline-safe: without `gh` the planned-marker lookup warns and skips
# locally (CI enforces). If it ever exceeds ~10s, scope it to staged docs instead of dropping it.
pnpm docs:staleness
