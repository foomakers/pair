#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# A linked worktree's hooks inherit GIT_DIR/GIT_INDEX_FILE: any fixture below that spawns `git init` in a
# temp dir would re-initialise THIS repository (core.bare=true). Scrubbed once, for everything the hook runs.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX GIT_NAMESPACE GIT_CEILING_DIRECTORIES GIT_IMPLICIT_WORK_TREE GIT_DISCOVERY_ACROSS_FILESYSTEM

# Local pre-commit is differential: run a check only when the staged files can affect it.
# The full gate stays in pre-push and CI.
staged=$(git diff --cached --name-only)
if echo "$staged" | grep -qE '\.(ts|tsx|mts|cts|js|mjs|cjs|json)$'; then pnpm ts:check || exit 1; fi
# docs:staleness is cheap (~3.4s). Offline-safe: without `gh` the planned-marker lookup warns and skips.
if echo "$staged" | grep -qE '\.(md|mdx)$|^docs/|^\.claude/|^packages/knowledge-hub/'; then pnpm docs:staleness || exit 1; fi
