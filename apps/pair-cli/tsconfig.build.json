{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "vitest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.e2e.test.ts",
    "**/test-utils",
    "src/manifest/runtime-deps.ts"
  ]
}
