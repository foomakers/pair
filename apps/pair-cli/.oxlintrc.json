{
  "extends": ["../../tools/oxlint-config/base.json"],
  "ignorePatterns": [
    "/dist/",
    "/build/",
    "node_modules/",
    "/*.config.js",
    "/*.config.ts",
    "/playwright/",
    "/test-results/",
    "/dataset/.workflows/",
    "/dataset/.skills/**/scripts/**/*.mjs",
    "*.mts",
    "!*.mts/",
    "*.cts",
    "!*.cts/",
    "*.jsx",
    "!*.jsx/"
  ],
  "overrides": [
    {
      "files": [
        "src/commands/run/card-entry-prepare.test.ts",
        "src/commands/run/cycle.test.ts",
        "src/commands/run/workflow-facts.test.ts",
        "src/commands/run/workflow-host.test.ts"
      ],
      "rules": {
        "legacy-typescript/ban-ts-comment": [
          "error",
          { "ts-expect-error": "allow-with-description" }
        ]
      }
    }
  ]
}
